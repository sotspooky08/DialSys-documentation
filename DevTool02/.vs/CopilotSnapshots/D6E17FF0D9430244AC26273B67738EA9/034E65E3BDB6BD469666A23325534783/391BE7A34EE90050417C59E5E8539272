    }



    public void AddDialNode(object? Sender, EventArgs e)
    {
        if (Sender is Button btn) {
            if (btn.Parent is VerticalStackLayout VSL) {
                VSL.Children.Add(DialogueLine());
            } else {
                RootNode.Children.Add(DialogueLine());
            } 
        }
    }
    public void AddChoiceBlock(object? sender, EventArgs e)
    {
        if (sender is Button btn) {
            if (btn.Parent is VerticalStackLayout vsl) {
                ChoiceBlockLayout CBL = new(this, vsl);
                vsl.Children.Add(CBL.returnChoiceBlockLayout());
            } else {
                ChoiceBlockLayout CBL = new(this,RootNode);
                RootNode.Children.Add(CBL.returnChoiceBlockLayout());
            }
        }
    }
    public void AddChoice(object? sender, EventArgs e)
    {
        bool a = false;
        
        if (sender is Button btn) {
            var b = btn.Parent;
            while (!a) {     
                
                if (b is Choice cb) {
                    Choice choice = new(this);
                    cb.Children.Add(choice.returnChoice());
                    a = true;
                }else if (b == RootNode) {
                    RootNode.Children.Add(new Choice(this).returnChoice());
                    a = true;
                } else {
                    b = b.Parent;
                }
            }
        }
    }
    public async void RemoveNode(object? sender, EventArgs e)
    {
        
        if (sender is Button btn && btn.Parent is HorizontalStackLayout hsl && hsl.Parent is Layout parentLayout) {
            bool confirm = await DisplayAlert("You suree??", "Would you like to remove the dialogue line? All text entered here will be lost permanantly", "OK", "NO");
            if (confirm) {
                parentLayout.Children.Remove(hsl);
            }
        }
    }
