    public abstract class DialBlock : VerticalStackLayout { }
    public class ChoiceBlockLayout : DialBlock
    {
        private readonly EditConvoPage _parentPage;
        private VerticalStackLayout _selectedNode;
        
        public ChoiceBlockLayout(EditConvoPage parentPage, VerticalStackLayout selectedNode)
        {
            _parentPage = parentPage;
            _selectedNode = selectedNode;
        }
        public Layout returnChoiceBlockLayout()
        {
            HorizontalStackLayout main_hsl= new();
            VerticalStackLayout vsl= new();
            
            Button AddDial = new Button() { Text = "AddChoice" };
            AddDial.Clicked += _parentPage.AddChoice;
            Border border = new Border()
            {
                StrokeThickness = 2,
                Padding = 5,
                MinimumHeightRequest = 100,
                MinimumWidthRequest = 600,
                Stroke = Colors.White,
                Content = vsl
            };
            vsl.Children.Add(AddDial);
            var spacer = new BoxView() { WidthRequest = 20 };
            main_hsl.Children.Add(spacer);
            main_hsl.Children.Add(vsl);

            return main_hsl;
        }
    }



    public class Choice : DialBlock
