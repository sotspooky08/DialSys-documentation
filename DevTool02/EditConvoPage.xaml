             x:Class="DevTool01.EditConvoPage"
             Title="EditConvoPage">
    <ContentView>
        <Grid x:Name="MainStack" RowDefinitions = "*,Auto" Padding="10">
            
            <ScrollView Grid.Row="0" Orientation="Both">
                <VerticalStackLayout x:Name="RootNode" HorizontalOptions="Fill">
